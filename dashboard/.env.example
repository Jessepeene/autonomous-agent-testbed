# Shared secret behind the login page and the factory API's GET /dashboard/state.
# Must be the exact same value as the factory's own DASHBOARD_AUTH_TOKEN (see
# the superagent repo root's .env.example) -- generate one with:
#   openssl rand -hex 32
DASHBOARD_AUTH_TOKEN="MY_DASHBOARD_AUTH_TOKEN"

# Where this app reaches the real factory API from -- the internal
# docker-compose network address, not a public URL. Never exposed to the
# browser: only server-side code (lib/factory-api.ts) ever reads this.
FACTORY_API_BASE_URL="http://factory:8000"
