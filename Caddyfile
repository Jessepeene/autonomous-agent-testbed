dash.{$PUBLIC_DOMAIN} {
	reverse_proxy dashboard:3000
}

{$PUBLIC_DOMAIN} {
	# /metrics carries the factory's full financial and operational state (see
	# observability/metrics.py::collect). /dashboard/* carries the same plus
	# task/product/interrupt detail. Both were publicly readable by anyone who
	# guessed the path. Refused here rather than merely authenticated, so a
	# misconfigured or missing auth token can never expose them either -- the
	# app-side bearer check in api/app.py is the second layer, not the only
	# one. The dashboard itself is only served from dash.{$PUBLIC_DOMAIN} above.
	@internal path /metrics /metrics/* /dashboard/*
	respond @internal 404

	reverse_proxy factory:8000 {
		# Overwrite, never append: Caddy's default appends the client's own
		# X-Forwarded-For, so a caller could pin any value it liked and defeat
		# per-IP rate limiting (api/abuse.py) by sending a fresh header per
		# request. {remote_host} is the TCP peer, which a client cannot forge.
		header_up X-Forwarded-For {remote_host}
	}
}
