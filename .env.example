# Copy to .env and fill in. Never commit .env.
# Twelve-Factor: every secret comes from the environment. There are no code defaults.

# ---- HARD BLOCK: the factory refuses to boot without these ----
# Postgres. Either the bundled compose service or a hosted instance (Neon/Supabase).
DATABASE_URL=postgresql+asyncpg://factory:factory@localhost:5432/factory
# At least ONE of the two provider keys is required.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- DEGRADES: missing values disable specific engines, not the factory ----
# Human-in-the-loop (the only escalation channel).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Finance engine.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ISSUING_CARD_ID=

# Development engine deploy targets.
VERCEL_TOKEN=
CLOUDFLARE_API_TOKEN=
GITHUB_TOKEN=

# Discovery sources.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
PRODUCTHUNT_TOKEN=

# B2B lead providers. Without at least one, autonomous sourcing has nothing to
# search — the operator CSV drop at workspaces/lead-drops/*.csv is a manual override
# an operator invokes directly, not something the factory falls back to on its own.
# Metered per lookup — the quota is a hard cap on records created per rolling 30
# days, enforced before any API call is made.
HUNTER_API_KEY=
APOLLO_API_KEY=
LEAD_PROVIDER_MONTHLY_QUOTA=500

# Marketing transport: a deliverability API (Mailgun), not raw SMTP — raw SMTP from
# the primary domain has no IP rotation, no warmup, and no bounce/complaint feedback
# loop, and burns sender reputation within days of cold sending.
# MAILGUN_BASE_URL: EU accounts must use https://api.eu.mailgun.net/v3 instead.
# MAILGUN_WEBHOOK_SIGNING_KEY: Mailgun dashboard -> Sending -> Webhooks -> "HTTP
# webhook signing key" (different from the API key) -- required for the
# /webhooks/mailgun endpoint to accept bounce/complaint events at all.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=https://api.mailgun.net/v3
MAILGUN_WEBHOOK_SIGNING_KEY=
OUTBOUND_FROM_ADDRESS=
OUTBOUND_POSTAL_ADDRESS=
UNSUBSCRIBE_BASE_URL=

# ---- Operational ----
# Leave 1 until the guardrails have been exercised once. 0 permits real spend/email/deploy.
FACTORY_DRY_RUN=1
MAX_CONCURRENT_BUILDS=2
COMPLIANCE_MIN_CONFIDENCE=0.85
LOG_LEVEL=INFO

# ---- Sandbox / paths (container deployments MUST set these explicitly) ----
# The code default (derived from the repo checkout location) is only correct when
# running directly from a checkout. Once installed via `pip install .` into a
# container, that default resolves to a meaningless site-packages path — so both of
# these MUST be set explicitly to match the Dockerfile's actual layout.
#
# WORKSPACE_ROOT doubles as the bind-mount path in docker-compose.yml: the factory
# drives the *host* Docker daemon to launch sibling sandbox containers, and that
# daemon resolves volume-mount sources against the host filesystem, not this
# container's. This value MUST therefore be the exact same path on both sides of the
# docker-compose.yml volume line, or every sandbox container silently gets an empty
# workspace. `factory.preflight.check_sandbox_workspace_sharing` verifies this at
# every boot and disables Development with a specific, loud reason if it's wrong.
WORKSPACE_ROOT=/srv/factory-workspaces
BLACKLIST_PATH=/app/blacklist.txt

# The factory container runs as a fixed non-root user but needs to talk to the
# *host's* docker.sock (owned by root:docker, mode 660) to launch sandbox
# containers. Without matching group membership, every attempt silently fails and
# Development reports "no Docker daemon" forever. This GID is host-specific (not
# something the image can bake in) — set it from the host itself:
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Model IDs are settings, not literals -- update them as providers retire old
# versions. Preflight does NOT validate these against the live API: a model can be
# listed in the provider's catalog and still reject real requests for a given key/
# project (discovered live: gemini-2.5-pro/-flash were both listed but returned
# 404 "no longer available to new users" / 429 quota-exceeded for a freshly
# created key). A real per-boot smoke test would cost tokens and risk tripping
# quota on every restart, so this is deliberately left as an operational check --
# if the factory logs repeated llm.retry/orchestrator.llm_failed events, check the
# provider's current model list before assuming it's a quota problem.
# The "-latest" aliases below track the provider's current recommended model
# instead of a dated snapshot, which is more resilient for a system that runs
# unattended for weeks -- pin to a dated version instead if you need reproducible
# model behavior (e.g. for the learning loop's trial comparisons).
MODEL_GENERAL=gemini-pro-latest
MODEL_FAST=gemini-flash-latest
MODEL_CODE=claude-sonnet-5
